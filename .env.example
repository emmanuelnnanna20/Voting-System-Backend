# ==============================================
# VOTING SYSTEM ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ==============================================

# ----------------------------------------------
# DATABASE CONFIGURATION (Local Development)
# ----------------------------------------------
DB_USER=root
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=voting_system

# ----------------------------------------------
# AIVEN MYSQL CONFIGURATION (Production)
# Uncomment and use these when deploying to Render
# ----------------------------------------------
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_HOST=your-project.aivencloud.com
# DB_PORT=your_aiven_port
# DB_NAME=defaultdb
# AIVEN_CA_CERT_PATH=/path/to/ca.pem

# ----------------------------------------------
# JWT AUTHENTICATION
# Generate a secure key with:
# python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------
JWT_SECRET_KEY=your-secret-key-change-in-production

# ----------------------------------------------
# EMAIL CONFIGURATION (Gmail SMTP)
# Get App Password from: https://myaccount.google.com/apppasswords
# ----------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SENDER_EMAIL=your-email@gmail.com

# ----------------------------------------------
# FRONTEND URL
# Local: http://localhost:3000
# Production: https://your-frontend.onrender.com
# ----------------------------------------------
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------
# SERVER PORT (Optional - Render sets this automatically)
# ----------------------------------------------
# PORT=8000